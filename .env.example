# Copy to .env.local. Never put secrets in variables starting with VITE_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_COACH_MODEL=gpt-4o-mini

# Production requires a private access code of at least 16 characters.
# Share the code with trainees, never your OpenAI API key.
PRACTICE_ACCESS_CODE=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8787,http://localhost:8787
HOST=127.0.0.1
PORT=8787

# For GitHub Pages + a separately hosted backend only: public HTTPS origin.
# Leave empty for local development or serving both from the Node server.
VITE_PRACTICE_API_URL=
